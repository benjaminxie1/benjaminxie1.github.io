---
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  /** Fit the page to one screen with no scrolling (desktop). */
  fit?: boolean;
  description?: string;
  /** Keep this page out of search engines (draft previews). */
  noindex?: boolean;
  /** Social preview image (site path or URL), e.g. a post cover. Defaults to /og.png. */
  image?: string;
  /** Marks the page as a blog post: og:type article, dates, tags and BlogPosting JSON-LD. */
  article?: { published: Date; modified?: Date; tags?: string[]; minutes?: number };
}
const { title, description = site.description, fit = false, noindex = false, image, article } = Astro.props;
const pageTitle = title ? `${title} · ${site.short}` : site.short;
const absolute = (u: string) => {
  try { return new URL(u, Astro.site).href; } catch { return null; }
};
const cover = image ? absolute(image) : null;
const ogImage = cover ?? new URL('/og.png', Astro.site).href;
const ogAlt = cover ? (title ?? site.name) : 'Ben Xie — EECS & Business at UC Berkeley';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const iso = (d: Date) => d.toISOString();
const author = { '@type': 'Person', name: site.name, url: new URL('/', Astro.site).href, sameAs: [site.github, site.linkedin, site.x] };
const jsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonical,
  mainEntityOfPage: canonical,
  image: [ogImage],
  datePublished: iso(article.published),
  dateModified: iso(article.modified ?? article.published),
  author,
  publisher: author,
  ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
  ...(article.minutes ? { timeRequired: `PT${article.minutes}M` } : {}),
  inLanguage: 'en',
};
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {!cover && <meta property="og:image:width" content="1200" />}
    {!cover && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogAlt} />
    {article && <meta property="article:published_time" content={iso(article.published)} />}
    {article?.modified && <meta property="article:modified_time" content={iso(article.modified)} />}
    {article && <meta property="article:author" content={site.name} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@_benjaminxie" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {article && <meta name="author" content={site.name} />}
    {article?.minutes && <meta name="twitter:label1" content="Reading time" />}
    {article?.minutes && <meta name="twitter:data1" content={`${article.minutes} min read`} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Ben Xie · Blog" href="/rss.xml" />
  </head>
  <body class={fit ? 'fit' : undefined}>
    <header class="site-header">
      <a class={path === '/' ? 'wordmark hand' : 'wordmark'} href="/">{site.short}</a>
      <nav>
        {nav.map((n) => (
          <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      © {new Date().getFullYear()} {site.name}
    </footer>
  </body>
</html>
