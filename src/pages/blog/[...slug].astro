---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostBanner from '../../components/PostBanner.astro';
import '../../styles/post.css';
import '../../styles/reading.css';
import ReadMeta from '../../components/ReadMeta.astro';
import ReadToc from '../../components/ReadToc.astro';
import ReadPostNav from '../../components/ReadPostNav.astro';

export async function getStaticPaths() {
  // Published posts live at /blog/<slug>. Drafts get an unlisted (not secret)
  // preview at /blog/draft/<slug> (not in the list, RSS, sitemap or search).
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.data.draft ? `draft/${post.id}` : post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data.date;
const day = d.getUTCDate();
const suffix = day % 10 === 1 && day !== 11 ? 'st' : day % 10 === 2 && day !== 12 ? 'nd' : day % 10 === 3 && day !== 13 ? 'rd' : 'th';
const month = d.toLocaleDateString('en-US', { month: 'long', timeZone: 'UTC' });
// a post whose date couldn't be read gets epoch 0 from the schema (and is forced to draft)
const published = +d === 0 ? 'no date set' : `${month} ${day}${suffix}, ${d.getUTCFullYear()}`;
---

<Base title={post.data.title} description={post.data.description || undefined} noindex={post.data.draft}>
  <main class="post-main">
    <PostBanner seed={post.id} cover={post.data.cover} />
    <article class="post">
      <header class="head">
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="dek">{post.data.description}</p>}
      </header>
      <ReadMeta post={post} published={published} />
      <div class="read-main">
        <ReadToc post={post} />
        <div class="body"><Content /></div>
        <script is:inline>
          // Opening word in accent italics, after the drop cap (same as the /write editor).
          (function () {
            var p = document.currentScript.previousElementSibling.firstElementChild;
            if (!p || p.tagName !== 'P' || !p.firstChild || p.firstChild.nodeType !== 3) return;
            var t = p.firstChild, m = /^(\S)([^\s.,;:!?—–-]*)/.exec(t.data);
            if (!m || !m[2]) return;
            var span = document.createElement('span');
            span.className = 'lead-word';
            span.textContent = m[2];
            t.data = t.data.slice(m[0].length);
            p.insertBefore(document.createTextNode(m[1]), t);
            p.insertBefore(span, t);
          })();
        </script>
      </div>
      <ReadPostNav post={post} />
    </article>
  </main>
  <script>
    import '../../scripts/read/index';
  </script>
</Base>
