---
import { getCollection, render } from 'astro:content';
import { routeOf, isScheduled, postTags, readingMinutes, excerpt } from '../../data/posts';
import Base from '../../layouts/Base.astro';
import PostBanner from '../../components/PostBanner.astro';
import '../../styles/post.css';

export async function getStaticPaths() {
  // Published posts live at /blog/<slug>. Drafts and scheduled (future-dated)
  // posts get an unlisted (not secret) preview at /blog/draft/<slug> (not in
  // the list, RSS, sitemap or search). See src/data/posts.ts.
  const posts = await getCollection('blog');
  return posts.map((p) => ({
    params: { slug: routeOf(p) },
    // a scheduled post previews exactly like a draft until its day comes
    props: { post: isScheduled(p) ? { ...p, data: { ...p.data, draft: true } } : p, scheduled: isScheduled(p) },
  }));
}

const { post, scheduled } = Astro.props;
// for the post body: tags (with /blog/tags/<slug> links), last edit, reading time
const tags = postTags(post);
const updated = post.data.updated && +post.data.updated > +post.data.date ? post.data.updated : undefined;
const minutes = readingMinutes(post.body);
const { Content } = await render(post);
const d = post.data.date;
const day = d.getUTCDate();
const suffix = day % 10 === 1 && day !== 11 ? 'st' : day % 10 === 2 && day !== 12 ? 'nd' : day % 10 === 3 && day !== 13 ? 'rd' : 'th';
const month = d.toLocaleDateString('en-US', { month: 'long', timeZone: 'UTC' });
// a post whose date couldn't be read gets epoch 0 from the schema (and is forced to draft)
const published = +d === 0 ? 'no date set' : `${month} ${day}${suffix}, ${d.getUTCFullYear()}`;
---

<Base
  title={post.data.title}
  description={post.data.description || excerpt(post.body) || undefined}
  noindex={post.data.draft}
  image={post.data.cover}
  article={post.data.draft ? undefined : { published: post.data.date, modified: updated, tags: tags.map((t) => t.name), minutes }}
>
  <main class="post-main">
    <PostBanner seed={post.id} cover={post.data.cover} />
    <article class="post">
      <header class="head">
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="dek">{post.data.description}</p>}
      </header>
      {post.data.draft ? (
        <p class="published"><span class="draft-tag">Draft preview</span>· {published}</p>
      ) : (
        <p class="published">Published {published}</p>
      )}
      <div class="body"><Content /></div>
      <script is:inline>
        // Opening word in accent italics, after the drop cap (same as the /write editor).
        (function () {
          var p = document.currentScript.previousElementSibling.firstElementChild;
          if (!p || p.tagName !== 'P' || !p.firstChild || p.firstChild.nodeType !== 3) return;
          var t = p.firstChild, m = /^(\S)([^\s.,;:!?—–-]*)/.exec(t.data);
          if (!m || !m[2]) return;
          var span = document.createElement('span');
          span.className = 'lead-word';
          span.textContent = m[2];
          t.data = t.data.slice(m[0].length);
          p.insertBefore(document.createTextNode(m[1]), t);
          p.insertBefore(span, t);
        })();
      </script>
      <p class="back"><a href="/blog">← All posts</a></p>
    </article>
  </main>
</Base>
