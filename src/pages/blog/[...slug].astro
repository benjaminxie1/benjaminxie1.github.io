---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostBanner from '../../components/PostBanner.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data.date;
const day = d.getUTCDate();
const suffix = day % 10 === 1 && day !== 11 ? 'st' : day % 10 === 2 && day !== 12 ? 'nd' : day % 10 === 3 && day !== 13 ? 'rd' : 'th';
const month = d.toLocaleDateString('en-US', { month: 'long', timeZone: 'UTC' });
const published = `${month} ${day}${suffix}, ${d.getUTCFullYear()}`;
---

<Base title={post.data.title} description={post.data.description || undefined}>
  <main class="post-main">
    <PostBanner seed={post.id} cover={post.data.cover} />
    <article class="post">
      <header class="head">
        <h1>{post.data.title}</h1>
        {post.data.description && <p class="dek">{post.data.description}</p>}
      </header>
      <p class="published">Published {published}</p>
      <div class="body"><Content /></div>
      <p class="back"><a href="/blog">← All posts</a></p>
    </article>
  </main>
</Base>

<style>
  .post {
    max-width: 640px;
    margin: 0 auto;
  }
  .head {
    text-align: center;
    margin: 8px 0 56px;
  }
  .head h1 {
    font-size: clamp(44px, 6vw, 64px);
    line-height: 1.05;
    margin: 0 0 22px;
  }
  .dek {
    max-width: 560px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }
  .published {
    color: var(--muted);
    font-size: 14px;
    margin: 0 0 28px;
  }
  .body {
    font-size: 17px;
    line-height: 1.85;
    color: #3a3833;
  }
  /* Handwritten drop cap + a slightly heavier opening line */
  .body > :global(p:first-child::first-letter) {
    float: left;
    font-family: var(--hand);
    font-size: 5.4em;
    line-height: 0.8;
    padding: 0.06em 0.06em 0 0;
    margin-right: 0.22em;
    color: var(--tag);
  }
  .body > :global(p:first-child::first-line) {
    font-weight: 600;
    color: var(--ink);
  }
  .body :global(p) {
    margin: 0 0 1.25em;
  }
  .body :global(img) {
    max-width: 100%;
    border-radius: 10px;
    margin: 8px 0;
  }
  .body :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .body :global(blockquote) {
    margin: 28px 0;
    padding-left: 18px;
    border-left: 2px solid var(--tag);
    color: var(--muted);
  }
  .body :global(h2) {
    margin: 44px 0 12px;
    font-size: 34px;
  }
  .body :global(h3) {
    margin: 30px 0 8px;
    font-size: 26px;
  }
  .body :global(hr) {
    border: 0;
    text-align: center;
    margin: 40px 0;
  }
  .body :global(hr::after) {
    content: '· · ·';
    color: var(--muted);
    letter-spacing: 0.4em;
  }
  .back {
    margin-top: 56px;
    font-size: 14px;
  }
  .back a {
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .head { margin-bottom: 36px; }
    .body { font-size: 16px; }
  }
</style>
