---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import TagBar from '../../components/TagBar.astro';
import { livePosts, tagsOf } from '../../data/posts';

const posts = await livePosts(); // drafts and scheduled posts are never listed
const tags = tagsOf(posts);
---

<Base title="Blog" description="Writing by Ben Xie.">
  <main class="narrow">
    <h1>Blog</h1>
    {posts.length === 0 ? (
      <p class="muted">Nothing here yet. Soon.</p>
    ) : (
      <>
        <TagBar tags={tags} total={posts.length} />
        <PostList posts={posts} />
      </>
    )}
    <p class="small muted rss"><a href="/rss.xml">RSS</a> · subscribe in any feed reader</p>
  </main>
</Base>

<style>
  .rss {
    margin-top: 32px;
  }
  .rss a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
