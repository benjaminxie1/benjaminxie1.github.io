---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base title="Projects">
  <main class="narrow">
    <h1>Projects</h1>
    <ul class="plain">
      {projects.map((p) => (
        <li>
          <div class="row">
            <h3><a href={p.links[0]?.href}>{p.name}</a></h3>
            <span class="date">{p.date}</span>
          </div>
          {p.award && <span class="tag" style="margin:4px 0 0">{p.award}</span>}
          <p style="margin: 8px 0 0">{p.blurb}</p>
          <div class="muted small" style="margin-top:6px">
            {p.stack.join(' · ')}
            {p.links.map((l) => (
              <>
                {' · '}
                <a href={l.href}>{l.label}</a>
              </>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </main>
</Base>
