---
import Base from '../layouts/Base.astro';
import VillaScene from '../components/VillaScene.astro';
import { site, linkTarget } from '../data/site';
import { renderInline } from '../lib/inline';
import { loadSiteFile } from '../lib/site-content';
import { newItemFor, type SiteLink } from '../content/site/schema';
import raw from '../content/site/contact.json';

const contact = loadSiteFile('contact', raw);
const newLink = newItemFor('contact', '/links') as SiteLink;
---

<Base title={contact.heading} fit>
  <main>
    <section class="contact">
      <h1 data-edit="contact:/heading" data-edit-kind="plain">{contact.heading}</h1>
      <p><span data-edit="contact:/lead" data-edit-kind="inline" set:html={renderInline(contact.lead)} /> <a href={`mailto:${site.email}`} data-edit="site:/email" data-edit-kind="plain">{site.email}</a>.</p>
      {(() => {
        // one link; also rendered from the schema's newItem into the editor's <template>
        const Link = (l: SiteLink, i: number | string) => {
          const t = linkTarget(l, `contact:/links/${i}`);
          return (
            <a
              href={t.href}
              data-edit-item={`contact:/links/${i}`}
              data-edit-sitelink={`contact:/links/${i}`}
              data-edit={`contact:/links/${i}/label`}
              data-edit-kind="plain"
              data-edit-href={t.editHref}
            >{l.label}</a>
          );
        };
        return (
          <>
            <p class="links" data-edit-list="contact:/links">{contact.links.map((l, i) => Link(l, i))}</p>
            <template data-edit-template="contact:/links">{Link(newLink, '__i__')}</template>
          </>
        );
      })()}
    </section>
    <section class="footer-art">
      <VillaScene />
    </section>
  </main>
</Base>

<style>
  .contact {
    max-width: 640px;
  }
  .contact a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 4px;
  }
  .contact a:hover {
    color: var(--link);
  }
  .contact p {
    overflow-wrap: break-word;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }
  .footer-art {
    margin-top: 40px;
  }
  @media (min-width: 961px) and (min-height: 560px) {
    .footer-art { flex: 1; min-height: 0; margin-top: 24px; display: flex; flex-direction: column; justify-content: flex-end; }
    .footer-art :global(.villa) { height: 100%; max-height: 640px; aspect-ratio: auto; }
  }
  @media (max-width: 640px) {
    .footer-art { margin-top: 8px; }
  }
</style>
