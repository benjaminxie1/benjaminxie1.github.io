---
import Base from '../layouts/Base.astro';

const experience = [
  {
    role: 'Student',
    org: 'UC Berkeley',
    href: 'https://met.berkeley.edu',
    dates: 'Aug. 2026 - Present',
    place: 'Berkeley, California, United States',
    logo: '/logos/berkeley.svg',
  },
  {
    role: 'Software Engineering Intern',
    org: 'Air Force Research Laboratory',
    href: 'https://www.afrl.af.mil',
    dates: 'Jun. 2025 - Aug. 2025',
    span: '3 mo',
    place: 'Wright-Patterson AFB, Ohio, United States',
    logo: '/logos/afrl.svg',
  },
  {
    role: 'Machine Learning Intern',
    org: 'AgentAI',
    href: 'https://www.agentai.app',
    dates: 'Jun. 2024 - Aug. 2024',
    span: '3 mo',
    place: 'Woodland Hills, California, United States',
    logo: '/logos/agentai.svg',
  },
];

const wins = [
  {
    event: 'Gemini 4 Argon Hackathon',
    href: 'https://cerebralvalley.ai/e/gemini-4-argon-sf',
    host: 'Cerebral Valley',
    sponsor: { src: '/sponsors/google-deepmind.svg', alt: 'Google DeepMind', h: 22 },
    project: 'LabTwin',
    pitch: 'Digital twin world models for the wet lab. Test your experiment virtually before you run it.',
    badge: '$7.5k prize',
    date: '2026',
    image: '/projects/labtwin.jpg',
    links: [{ label: 'GitHub', href: 'https://github.com/benjaminxie1/argon-hacks' }],
  },
  {
    event: 'a16z SpeedHacks',
    href: 'https://www.tech-week.com/calendar/sf/events/speedhacks-the-official-speedrun-hackathon-30c239a4-638a-4bd6-8d51-e15259668f51',
    host: 'a16z speedrun',
    sponsor: { src: '/sponsors/a16z.svg', alt: 'Andreessen Horowitz', h: 24 },
    project: 'Recourse',
    pitch: 'An agent that preps refund and insurance claims, then makes the call.',
    badge: '$1k prize',
    date: '2026',
    links: [{ label: 'GitHub', href: 'https://github.com/Will-code112223/Speedhacks' }],
  },
  {
    event: 'Congressional App Challenge',
    href: 'https://www.congressionalappchallenge.us/24-CA26/',
    host: 'Rep. Julia Brownley, CA-26',
    sponsor: { src: '/sponsors/cac.png', alt: 'Congressional App Challenge', h: 24, dark: true },
    project: 'Sentinel',
    pitch: 'A YOLO wildfire-detection camera network, piloted in the Santa Monica Mountains.',
    badge: 'U.S. Capitol',
    date: '2024',
    image: '/projects/sentinel.jpg',
    links: [
      { label: 'YouTube', href: 'https://www.youtube.com/watch?v=MKWk8RUUmRI' },
      { label: 'GitHub', href: 'https://github.com/benjaminxie1/sentinel-app' },
    ],
  },
];
const icons: Record<string, string> = {
  GitHub: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  YouTube: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
};
---

<Base title="Experience">
  <main>
    <h1>Experience</h1>
    <ol class="timeline">
      {experience.map((e) => (
        <li>
          <img class="logo" src={e.logo} alt="" width="60" height="60" />
          <div>
            <a class="role" href={e.href}>{e.role}</a>.
            <div>{e.org}.</div>
            <div>{e.dates}.{e.span && <span class="muted small"> ({e.span})</span>}</div>
            <div class="muted">{e.place}.</div>
          </div>
        </li>
      ))}
    </ol>

    <h2>Projects</h2>
    <ul class="wins">
      {wins.map((w) => (
        <li>
          <div class="win">
            <a class="shot" href={w.links[0].href} aria-label={`${w.project} on ${w.links[0].label}`}>
              {w.image ? (
                <img src={w.image} alt="" width="800" height="500" loading="lazy" />
              ) : (
                <div class="rc" aria-hidden="true">
                  <div class="rc-bar"><span></span><span></span><span></span></div>
                  <div class="rc-msg">Ridgeline charged me twice but I lost the receipt</div>
                  <div class="rc-card">
                    <div class="rc-row"><span class="rc-k">Refund request</span><span class="rc-v">$214.00</span></div>
                    <div class="rc-row"><span class="rc-k">Support line</span><span class="rc-pill">Ready</span></div>
                    <div class="rc-btn">Approve this call</div>
                  </div>
                </div>
              )}
            </a>
            <div class="info">
              <div class="top">
                <span class={w.sponsor.dark ? 'sponsor dark' : 'sponsor'}>
                  <img src={w.sponsor.src} alt={w.sponsor.alt} style={`height:${w.sponsor.h}px`} />
                </span>
                <span class="year">{w.date}</span>
              </div>
              <div class="line">
                <a class="ev" href={w.href}>{w.event}</a><span class="dots"></span><span class="amt">1st Place</span>
              </div>
              <div class="meta muted small">
                <span class="prize">{w.badge}</span>
                <span><strong>{w.project}</strong> · {w.host}</span>
              </div>
              <div class="bottom">
                <p class="small pitch">{w.pitch}</p>
                <div class="icons">
                  {w.links.map((l) => (
                    <a class="ic" href={l.href} aria-label={`${w.project} on ${l.label}`} title={l.label}>
                      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={icons[l.label]} /></svg>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    max-width: 780px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.85;
  }
  .timeline li:first-child {
    padding-top: 12px;
  }
  .logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
  .role {
    font-size: 18px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .role:hover {
    color: var(--link);
  }
  h2 {
    margin-top: 64px;
  }
  .wins {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    max-width: 780px;
    display: grid;
    gap: 18px;
  }
  .win {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 26px;
    align-items: center;
    padding: 14px;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: #fdfcf9;
    color: var(--ink);
    transition: border-color 0.18s;
  }
  .win:hover {
    border-color: color-mix(in srgb, var(--muted) 55%, transparent);
  }
  .shot {
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    background: #2e3038;
  }
  .shot {
    display: block;
    transition: transform 0.18s;
  }
  .shot:hover {
    transform: scale(1.015);
  }
  .sponsor {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
  }
  .sponsor.dark {
    padding: 4px 8px;
    border-radius: 6px;
    background: #14284a;
  }
  .sponsor img {
    display: block;
    width: auto;
  }
  .sponsor-text {
    font-family: system-ui, -apple-system, 'Helvetica Neue', sans-serif;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.02em;
    color: #111111;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .top .sponsor {
    margin-bottom: 0;
  }
  .year {
    font-size: 14px;
    color: var(--muted);
  }
  .bottom {
    display: flex;
    align-items: flex-end;
    gap: 16px;
  }
  .bottom .pitch {
    flex: 1;
  }
  .icons {
    display: flex;
    gap: 8px;
    flex: none;
  }
  .ic {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--rule);
    border-radius: 9px;
    background: #ffffff;
    color: var(--ink);
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
  }
  .ic svg {
    fill: currentColor;
  }
  .ic:hover {
    color: var(--link);
    border-color: color-mix(in srgb, var(--muted) 55%, transparent);
    transform: translateY(-1px);
  }
  .lk {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--muted) 60%, transparent);
    text-underline-offset: 3px;
  }
  .lk:hover {
    color: var(--link);
  }
  .shot > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .info {
    padding-right: 10px;
    line-height: 1.75;
  }
  .line {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .ev {
    font-size: 18px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .dots {
    flex: 1;
    min-width: 16px;
    border-bottom: 2px dotted color-mix(in srgb, var(--muted) 45%, transparent);
    transform: translateY(-5px);
  }
  .amt {
    font-family: var(--hand);
    font-size: 30px;
    line-height: 1;
    white-space: nowrap;
    color: var(--link);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-top: 6px;
  }
  .prize {
    display: inline-block;
    padding: 1px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--link) 13%, transparent);
    color: var(--link);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.7;
    vertical-align: 1px;
  }
  .info strong {
    color: var(--ink);
    font-weight: 600;
  }
  .pitch {
    margin: 6px 0 0;
    color: var(--muted);
    line-height: 1.65;
  }
  /* Recourse mini-UI, in the app's own black-on-white style */
  .rc {
    height: 100%;
    background: #ffffff;
    color: #111111;
    font: 10.5px/1.4 system-ui, -apple-system, sans-serif;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }
  .rc-bar {
    display: flex;
    gap: 4px;
  }
  .rc-bar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #dddddd;
  }
  .rc-msg {
    align-self: flex-end;
    max-width: 82%;
    background: #111111;
    color: #f2f2f2;
    padding: 6px 9px;
    border-radius: 10px 10px 2px 10px;
  }
  .rc-card {
    border: 1px solid #dddddd;
    border-radius: 8px;
    padding: 7px 10px;
    display: grid;
    gap: 4px;
  }
  .rc-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .rc-k {
    color: #666666;
  }
  .rc-v {
    font-weight: 600;
  }
  .rc-pill {
    font-size: 9.5px;
    padding: 1px 7px;
    border-radius: 99px;
    background: #e8f3ec;
    color: #2f6b45;
  }
  .rc-btn {
    margin-top: 2px;
    text-align: center;
    background: #111111;
    color: #ffffff;
    border-radius: 6px;
    padding: 5px 0;
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .timeline li {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 16px;
    }
    .logo {
      width: 44px;
      height: 44px;
    }
    .win {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .info {
      padding: 0 4px 4px;
    }
    .line {
      justify-content: space-between;
    }
    .dots {
      display: none;
    }
  }
</style>
