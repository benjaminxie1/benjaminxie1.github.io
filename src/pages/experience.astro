---
import Base from '../layouts/Base.astro';

const experience = [
  {
    role: 'Student',
    org: 'UC Berkeley',
    href: 'https://met.berkeley.edu',
    dates: 'Aug. 2026 - Present',
    place: 'Berkeley, California, United States',
    logo: '/logos/berkeley.svg',
  },
  {
    role: 'Software Engineering Intern',
    org: 'Air Force Research Laboratory',
    href: 'https://www.afrl.af.mil',
    dates: 'Jun. 2025 - Aug. 2025',
    span: '3 mo',
    place: 'Wright-Patterson AFB, Ohio, United States',
    logo: '/logos/afrl.svg',
  },
  {
    role: 'Machine Learning Intern',
    org: 'AgentAI',
    href: 'https://www.agentai.app',
    dates: 'Jun. 2024 - Aug. 2024',
    span: '3 mo',
    place: 'Woodland Hills, California, United States',
    logo: '/logos/agentai.svg',
  },
];

const wins = [
  {
    event: 'Gemini 4 Argon Hackathon',
    date: 'Oct. 2026',
    href: 'https://cerebralvalley.ai/e/gemini-4-argon-sf',
  },
  {
    event: 'a16z SpeedHacks',
    date: 'Oct. 2026',
    href: 'https://www.tech-week.com/calendar/sf/events/speedhacks-the-official-speedrun-hackathon-30c239a4-638a-4bd6-8d51-e15259668f51',
  },
];
---

<Base title="Experience">
  <main>
    <h1>Experience</h1>
    <ol class="timeline">
      {experience.map((e) => (
        <li>
          <img class="logo" src={e.logo} alt="" width="60" height="60" />
          <div>
            <a class="role" href={e.href}>{e.role}</a>.
            <div>{e.org}.</div>
            <div>{e.dates}.{e.span && <span class="muted small"> ({e.span})</span>}</div>
            <div class="muted">{e.place}.</div>
          </div>
        </li>
      ))}
    </ol>

    <h2>Hackathons</h2>
    <ol class="timeline">
      {wins.map((w) => (
        <li class="win">
          <span class="medal" aria-hidden="true">1st</span>
          <div>
            <a class="role" href={w.href}>{w.event}</a>.
            <div>1st Place. <span class="muted small">({w.date})</span></div>
          </div>
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    max-width: 780px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.85;
  }
  .timeline li:first-child {
    padding-top: 12px;
  }
  .logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
  .role {
    font-size: 18px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .role:hover {
    color: var(--link);
  }
  h2 {
    margin-top: 64px;
  }
  .win {
    align-items: center;
  }
  .medal {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 0 4px;
    border-radius: 50%;
    background: #e9c46a;
    color: #5c4813;
    font-weight: 700;
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .timeline li {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 16px;
    }
    .logo {
      width: 44px;
      height: 44px;
    }
    .medal {
      width: 40px;
      height: 40px;
      margin: 0 2px;
      font-size: 12px;
    }
  }
</style>
