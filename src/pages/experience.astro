---
import Base from '../layouts/Base.astro';
import { renderInline } from '../lib/inline';
import { loadSiteFile } from '../lib/site-content';
import {
  defaultAt, hrefOf, iconPath, newItemFor,
  type Job, type Mock, type MockRow, type Project, type ProjectLink, type Sponsor,
} from '../content/site/schema';
import raw from '../content/site/experience.json';

const page = loadSiteFile('experience', raw);
const X = 'experience:';
const newJob = newItemFor('experience', '/jobs') as Job;
const newProject = newItemFor('experience', '/projects') as Project;
const newLink = newItemFor('experience', '/projects/0/links') as ProjectLink;
const newRow = newItemFor('experience', '/projects/0/mock/rows') as MockRow;
// what a hidden optional part renders (so switching it on in the editor shows its default)
const dflt = {
  span: defaultAt('experience', '/jobs/0/span') as string,
  place: defaultAt('experience', '/jobs/0/place') as string,
  logo: defaultAt('experience', '/jobs/0/logo') as string,
  host: defaultAt('experience', '/projects/0/host') as string,
  sponsor: defaultAt('experience', '/projects/0/sponsor') as Sponsor,
  badge: defaultAt('experience', '/projects/0/badge') as string,
  image: defaultAt('experience', '/projects/0/image') as string,
  mock: defaultAt('experience', '/projects/0/mock') as Mock,
};
---

<Base title={page.heading}>
  {(() => {
    // Each repeated thing is rendered by one function, used both for the real items and for the
    // editor's <template> (from the schema's newItem, with __i__ / __j__ in place of indexes).
    const Job = (e: Job, i: number | string) => {
      const J = (k: string) => `${X}/jobs/${i}/${k}`;
      return (
        <li data-edit-item={`${X}/jobs/${i}`}>
          <span class="logo-box" data-edit-optional={J('logo')} hidden={e.logo === undefined}>
            <img class="logo" src={e.logo ?? dflt.logo} alt="" width="60" height="60" data-edit-img={J('logo')} />
          </span>
          <div class="job">
            <a class="role" href={hrefOf(e.href)} data-edit={J('role')} data-edit-kind="plain" data-edit-href={J('href')}>{e.role}</a>.
            <div><span data-edit={J('org')} data-edit-kind="plain">{e.org}</span>.</div>
            <div><span data-edit={J('dates')} data-edit-kind="plain">{e.dates}</span>.<span class="muted small" data-edit-optional={J('span')} hidden={e.span === undefined}> (<span data-edit={J('span')} data-edit-kind="plain">{e.span ?? dflt.span}</span>)</span></div>
            <div class="muted" data-edit-optional={J('place')} hidden={e.place === undefined}><span data-edit={J('place')} data-edit-kind="plain">{e.place ?? dflt.place}</span>.</div>
          </div>
        </li>
      );
    };
    const Row = (r: MockRow, i: number | string, j: number | string) => {
      const R = (k: string) => `${X}/projects/${i}/mock/rows/${j}/${k}`;
      return (
        <div class="rc-row" data-edit-item={`${X}/projects/${i}/mock/rows/${j}`}><span class="rc-k" data-edit={R('label')} data-edit-kind="plain">{r.label}</span><span class={r.pill ? 'rc-pill' : 'rc-v'} data-edit-class={`rc-pill=${R('pill')} rc-v=!${R('pill')}`} data-edit={R('value')} data-edit-kind="plain">{r.value}</span></div>
      );
    };
    const Icon = (l: ProjectLink, project: string, i: number | string, j: number | string) => {
      const L = (k: string) => `${X}/projects/${i}/links/${j}/${k}`;
      return (
        <a class="ic" href={hrefOf(l.href)} aria-label={`${project} on ${l.label}`} title={l.label} data-edit-item={`${X}/projects/${i}/links/${j}`} data-edit-href={L('href')} data-edit-attr={`title=${L('label')}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={iconPath(l.icon)} data-edit-icon={L('icon')} /></svg>
        </a>
      );
    };
    const Project = (w: Project, i: number | string) => {
      const P = (k: string) => `${X}/projects/${i}/${k}`;
      const sponsor = w.sponsor ?? dflt.sponsor;
      const mock = w.mock ?? dflt.mock;
      const first = w.links[0];
      return (
        <li data-edit-item={`${X}/projects/${i}`}>
          <div class="win">
            <a class="shot" href={hrefOf(first?.href ?? w.href)} aria-label={first ? `${w.project} on ${first.label}` : w.project} data-edit-attr={`href=${P('links/0/href')}|${P('href')}`}>
              <span class="shot-img" data-edit-optional={P('image')} hidden={w.image === undefined}>
                <img src={w.image ?? dflt.image} alt="" width="800" height="500" loading="lazy" data-edit-img={P('image')} />
              </span>
              <div class="rc" aria-hidden="true" data-edit-optional={P('mock')} hidden={w.mock === undefined}>
                <div class="rc-bar"><span></span><span></span><span></span></div>
                <div class="rc-msg" data-edit={P('mock/message')} data-edit-kind="plain">{mock.message}</div>
                <div class="rc-card">
                  <div class="rc-rows" data-edit-list={P('mock/rows')}>{mock.rows.map((r, j) => Row(r, i, j))}</div>
                  <template data-edit-template={P('mock/rows')}>{Row(newRow, i, '__j__')}</template>
                  <div class="rc-btn" data-edit={P('mock/button')} data-edit-kind="plain">{mock.button}</div>
                </div>
              </div>
            </a>
            <div class="info">
              <div class="top">
                <span class={sponsor.dark ? 'sponsor dark' : 'sponsor'} data-edit-optional={P('sponsor')} hidden={w.sponsor === undefined} data-edit-class={`dark=${P('sponsor/dark')}`}>
                  <img src={sponsor.src} alt={sponsor.alt} style={`height:${sponsor.h}px`} data-edit-img={P('sponsor/src')} data-edit-alt={P('sponsor/alt')} data-edit-style={`height=${P('sponsor/h')}`} />
                </span>
                <span class="year" data-edit={P('date')} data-edit-kind="plain">{w.date}</span>
              </div>
              <div class="line">
                <a class="ev" href={hrefOf(w.href)} data-edit={P('event')} data-edit-kind="plain" data-edit-href={P('href')}>{w.event}</a><span class="dots"></span><span class="amt" data-edit={P('place')} data-edit-kind="plain">{w.place}</span>
              </div>
              <div class="meta muted small">
                <span class="prize" data-edit-optional={P('badge')} hidden={w.badge === undefined}><span data-edit={P('badge')} data-edit-kind="plain">{w.badge ?? dflt.badge}</span></span>
                <span><strong data-edit={P('project')} data-edit-kind="plain">{w.project}</strong><span data-edit-optional={P('host')} hidden={w.host === undefined}> · <span data-edit={P('host')} data-edit-kind="plain">{w.host ?? dflt.host}</span></span></span>
              </div>
              <div class="bottom">
                <p class="small pitch" data-edit={P('pitch')} data-edit-kind="inline" set:html={renderInline(w.pitch)} />
                <div class="icons" data-edit-list={P('links')}>{w.links.map((l, j) => Icon(l, w.project, i, j))}</div>
                <template data-edit-template={P('links')}>{Icon(newLink, w.project, i, '__j__')}</template>
              </div>
            </div>
          </div>
        </li>
      );
    };
    return (
      <main>
        <h1 data-edit="experience:/heading" data-edit-kind="plain">{page.heading}</h1>
        <ol class="timeline" data-edit-list="experience:/jobs">{page.jobs.map((e, i) => Job(e, i))}</ol>
        <template data-edit-template="experience:/jobs">{Job(newJob, '__i__')}</template>

        <h2 data-edit="experience:/projectsHeading" data-edit-kind="plain">{page.projectsHeading}</h2>
        <ul class="wins" data-edit-list="experience:/projects">{page.projects.map((w, i) => Project(w, i))}</ul>
        <template data-edit-template="experience:/projects">{Project(newProject, '__i__')}</template>
      </main>
    );
  })()}
</Base>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    max-width: 780px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.85;
  }
  .timeline li:first-child {
    padding-top: 12px;
  }
  .logo-box {
    display: block;
  }
  .logo {
    display: block;
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
  /* the text stays in the second column even when there's no logo */
  .job {
    grid-column: 2;
    min-width: 0;
    overflow-wrap: break-word;
  }
  .role {
    font-size: 18px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .role:hover {
    color: var(--link);
  }
  h2 {
    margin-top: 64px;
  }
  .wins {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    max-width: 780px;
    display: grid;
    gap: 18px;
  }
  .win {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 26px;
    align-items: center;
    padding: 14px;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: #fdfcf9;
    color: var(--ink);
    transition: border-color 0.18s;
  }
  .win:hover {
    border-color: color-mix(in srgb, var(--muted) 55%, transparent);
  }
  .shot {
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    background: #2e3038;
  }
  .shot {
    display: block;
    transition: transform 0.18s;
  }
  .shot:hover {
    transform: scale(1.015);
  }
  .sponsor {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
  }
  .sponsor.dark {
    padding: 4px 8px;
    border-radius: 6px;
    background: #14284a;
  }
  .sponsor img {
    display: block;
    width: auto;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .top .sponsor {
    margin-bottom: 0;
  }
  .year {
    margin-left: auto;
    font-size: 14px;
    color: var(--muted);
  }
  .bottom {
    display: flex;
    align-items: flex-end;
    gap: 16px;
  }
  .bottom .pitch {
    flex: 1;
  }
  .icons {
    display: flex;
    gap: 8px;
    flex: none;
  }
  .ic {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--rule);
    border-radius: 9px;
    background: #ffffff;
    color: var(--ink);
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
  }
  .ic svg {
    fill: currentColor;
  }
  .ic:hover {
    color: var(--link);
    border-color: color-mix(in srgb, var(--muted) 55%, transparent);
    transform: translateY(-1px);
  }
  .shot-img {
    display: block;
    height: 100%;
  }
  .shot-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* an image wins over the mock when a project has both */
  .shot-img:not([hidden]) ~ .rc {
    display: none;
  }
  .rc-rows {
    display: contents;
  }
  .info {
    min-width: 0;
    padding-right: 10px;
    line-height: 1.75;
    overflow-wrap: break-word;
  }
  .line {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .ev {
    min-width: 0;
    font-size: 18px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .dots {
    flex: 1;
    min-width: 16px;
    border-bottom: 2px dotted color-mix(in srgb, var(--muted) 45%, transparent);
    transform: translateY(-5px);
  }
  .amt {
    font-family: var(--hand);
    font-size: 30px;
    line-height: 1;
    white-space: nowrap;
    color: var(--link);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-top: 6px;
  }
  .prize {
    display: inline-block;
    padding: 1px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--link) 13%, transparent);
    color: var(--link);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.7;
    vertical-align: 1px;
  }
  .info strong {
    color: var(--ink);
    font-weight: 600;
  }
  .pitch {
    margin: 6px 0 0;
    color: var(--muted);
    line-height: 1.65;
  }
  /* Recourse mini-UI, in the app's own black-on-white style */
  .rc {
    height: 100%;
    background: #ffffff;
    color: #111111;
    font: 10.5px/1.4 system-ui, -apple-system, sans-serif;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }
  .rc-bar {
    display: flex;
    gap: 4px;
  }
  .rc-bar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #dddddd;
  }
  .rc-msg {
    overflow-wrap: anywhere;
    align-self: flex-end;
    max-width: 82%;
    background: #111111;
    color: #f2f2f2;
    padding: 6px 9px;
    border-radius: 10px 10px 2px 10px;
  }
  .rc-card {
    border: 1px solid #dddddd;
    border-radius: 8px;
    padding: 7px 10px;
    display: grid;
    gap: 4px;
  }
  .rc-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .rc-k {
    color: #666666;
  }
  .rc-v {
    font-weight: 600;
  }
  .rc-pill {
    font-size: 9.5px;
    padding: 1px 7px;
    border-radius: 99px;
    background: #e8f3ec;
    color: #2f6b45;
  }
  .rc-btn {
    margin-top: 2px;
    text-align: center;
    background: #111111;
    color: #ffffff;
    border-radius: 6px;
    padding: 5px 0;
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .timeline li { line-height: 1.6; }
    .role { font-size: 17px; }
    .timeline li {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 16px;
    }
    .logo {
      width: 44px;
      height: 44px;
    }
    .win {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .info {
      padding: 0 4px 4px;
    }
    .line {
      justify-content: space-between;
    }
    .dots {
      display: none;
    }
  }
</style>
