---
import Base from '../layouts/Base.astro';
import { renderInline } from '../lib/inline';
import page from '../content/site/experience.json';

type Project = (typeof page.projects)[number] & {
  image?: string;
  mock?: { message: string; rows: { label: string; value: string; pill?: boolean }[]; button: string };
  sponsor: { src: string; alt: string; h: number; dark?: boolean };
};
const jobs: ((typeof page.jobs)[number] & { span?: string })[] = page.jobs;
const projects = page.projects as Project[];
const J = (i: number, k: string) => `experience:/jobs/${i}/${k}`;
const P = (i: number, k: string) => `experience:/projects/${i}/${k}`;
const icons: Record<string, string> = {
  pdf: 'M6 2a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6H6zm7 1.5L18.5 9H13V3.5zM8 13h8v1.5H8V13zm0 3.5h8V18H8v-1.5zM8 9.5h3V11H8V9.5z',
  github: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  youtube: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
};
---

<Base title={page.heading}>
  <main>
    <h1 data-edit="experience:/heading" data-edit-kind="plain">{page.heading}</h1>
    <ol class="timeline">
      {jobs.map((e, i) => (
        <li>
          <img class="logo" src={e.logo} alt="" width="60" height="60" />
          <div>
            <a class="role" href={e.href} data-edit={J(i, 'role')} data-edit-kind="plain" data-edit-href={J(i, 'href')}>{e.role}</a>.
            <div><span data-edit={J(i, 'org')} data-edit-kind="plain">{e.org}</span>.</div>
            <div><span data-edit={J(i, 'dates')} data-edit-kind="plain">{e.dates}</span>.{e.span && <span class="muted small"> (<span data-edit={J(i, 'span')} data-edit-kind="plain">{e.span}</span>)</span>}</div>
            <div class="muted"><span data-edit={J(i, 'place')} data-edit-kind="plain">{e.place}</span>.</div>
          </div>
        </li>
      ))}
    </ol>

    <h2 data-edit="experience:/projectsHeading" data-edit-kind="plain">{page.projectsHeading}</h2>
    <ul class="wins">
      {projects.map((w, i) => (
        <li>
          <div class="win">
            <a class="shot" href={w.links[0].href} aria-label={`${w.project} on ${w.links[0].label}`}>
              {w.image ? (
                <img src={w.image} alt="" width="800" height="500" loading="lazy" />
              ) : w.mock && (
                <div class="rc" aria-hidden="true">
                  <div class="rc-bar"><span></span><span></span><span></span></div>
                  <div class="rc-msg" data-edit={P(i, 'mock/message')} data-edit-kind="plain">{w.mock.message}</div>
                  <div class="rc-card">
                    {w.mock.rows.map((r, j) => (
                      <div class="rc-row"><span class="rc-k" data-edit={P(i, `mock/rows/${j}/label`)} data-edit-kind="plain">{r.label}</span><span class={r.pill ? 'rc-pill' : 'rc-v'} data-edit={P(i, `mock/rows/${j}/value`)} data-edit-kind="plain">{r.value}</span></div>
                    ))}
                    <div class="rc-btn" data-edit={P(i, 'mock/button')} data-edit-kind="plain">{w.mock.button}</div>
                  </div>
                </div>
              )}
            </a>
            <div class="info">
              <div class="top">
                <span class={w.sponsor.dark ? 'sponsor dark' : 'sponsor'}>
                  <img src={w.sponsor.src} alt={w.sponsor.alt} style={`height:${w.sponsor.h}px`} />
                </span>
                <span class="year" data-edit={P(i, 'date')} data-edit-kind="plain">{w.date}</span>
              </div>
              <div class="line">
                <a class="ev" href={w.href} data-edit={P(i, 'event')} data-edit-kind="plain" data-edit-href={P(i, 'href')}>{w.event}</a><span class="dots"></span><span class="amt" data-edit={P(i, 'place')} data-edit-kind="plain">{w.place}</span>
              </div>
              <div class="meta muted small">
                <span class="prize" data-edit={P(i, 'badge')} data-edit-kind="plain">{w.badge}</span>
                <span><strong data-edit={P(i, 'project')} data-edit-kind="plain">{w.project}</strong> · <span data-edit={P(i, 'host')} data-edit-kind="plain">{w.host}</span></span>
              </div>
              <div class="bottom">
                <p class="small pitch" data-edit={P(i, 'pitch')} data-edit-kind="inline" set:html={renderInline(w.pitch)} />
                <div class="icons">
                  {w.links.map((l, j) => (
                    <a class="ic" href={l.href} aria-label={`${w.project} on ${l.label}`} title={l.label} data-edit-href={P(i, `links/${j}/href`)}>
                      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={icons[l.icon]} /></svg>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    max-width: 780px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.85;
  }
  .timeline li:first-child {
    padding-top: 12px;
  }
  .logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
  .role {
    font-size: 18px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .role:hover {
    color: var(--link);
  }
  h2 {
    margin-top: 64px;
  }
  .wins {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    max-width: 780px;
    display: grid;
    gap: 18px;
  }
  .win {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 26px;
    align-items: center;
    padding: 14px;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: #fdfcf9;
    color: var(--ink);
    transition: border-color 0.18s;
  }
  .win:hover {
    border-color: color-mix(in srgb, var(--muted) 55%, transparent);
  }
  .shot {
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    background: #2e3038;
  }
  .shot {
    display: block;
    transition: transform 0.18s;
  }
  .shot:hover {
    transform: scale(1.015);
  }
  .sponsor {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
  }
  .sponsor.dark {
    padding: 4px 8px;
    border-radius: 6px;
    background: #14284a;
  }
  .sponsor img {
    display: block;
    width: auto;
  }
  .sponsor-text {
    font-family: system-ui, -apple-system, 'Helvetica Neue', sans-serif;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.02em;
    color: #111111;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .top .sponsor {
    margin-bottom: 0;
  }
  .year {
    font-size: 14px;
    color: var(--muted);
  }
  .bottom {
    display: flex;
    align-items: flex-end;
    gap: 16px;
  }
  .bottom .pitch {
    flex: 1;
  }
  .icons {
    display: flex;
    gap: 8px;
    flex: none;
  }
  .ic {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--rule);
    border-radius: 9px;
    background: #ffffff;
    color: var(--ink);
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
  }
  .ic svg {
    fill: currentColor;
  }
  .ic:hover {
    color: var(--link);
    border-color: color-mix(in srgb, var(--muted) 55%, transparent);
    transform: translateY(-1px);
  }
  .lk {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--muted) 60%, transparent);
    text-underline-offset: 3px;
  }
  .lk:hover {
    color: var(--link);
  }
  .shot > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .info {
    padding-right: 10px;
    line-height: 1.75;
  }
  .line {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .ev {
    font-size: 18px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .dots {
    flex: 1;
    min-width: 16px;
    border-bottom: 2px dotted color-mix(in srgb, var(--muted) 45%, transparent);
    transform: translateY(-5px);
  }
  .amt {
    font-family: var(--hand);
    font-size: 30px;
    line-height: 1;
    white-space: nowrap;
    color: var(--link);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-top: 6px;
  }
  .prize {
    display: inline-block;
    padding: 1px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--link) 13%, transparent);
    color: var(--link);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.7;
    vertical-align: 1px;
  }
  .info strong {
    color: var(--ink);
    font-weight: 600;
  }
  .pitch {
    margin: 6px 0 0;
    color: var(--muted);
    line-height: 1.65;
  }
  /* Recourse mini-UI, in the app's own black-on-white style */
  .rc {
    height: 100%;
    background: #ffffff;
    color: #111111;
    font: 10.5px/1.4 system-ui, -apple-system, sans-serif;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }
  .rc-bar {
    display: flex;
    gap: 4px;
  }
  .rc-bar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #dddddd;
  }
  .rc-msg {
    align-self: flex-end;
    max-width: 82%;
    background: #111111;
    color: #f2f2f2;
    padding: 6px 9px;
    border-radius: 10px 10px 2px 10px;
  }
  .rc-card {
    border: 1px solid #dddddd;
    border-radius: 8px;
    padding: 7px 10px;
    display: grid;
    gap: 4px;
  }
  .rc-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .rc-k {
    color: #666666;
  }
  .rc-v {
    font-weight: 600;
  }
  .rc-pill {
    font-size: 9.5px;
    padding: 1px 7px;
    border-radius: 99px;
    background: #e8f3ec;
    color: #2f6b45;
  }
  .rc-btn {
    margin-top: 2px;
    text-align: center;
    background: #111111;
    color: #ffffff;
    border-radius: 6px;
    padding: 5px 0;
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .timeline li { line-height: 1.6; }
    .role { font-size: 17px; }
    .timeline li {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 16px;
    }
    .logo {
      width: 44px;
      height: 44px;
    }
    .win {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .info {
      padding: 0 4px 4px;
    }
    .line {
      justify-content: space-between;
    }
    .dots {
      display: none;
    }
  }
</style>
