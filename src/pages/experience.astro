---
import Base from '../layouts/Base.astro';

const experience = [
  {
    role: 'Student',
    org: 'UC Berkeley',
    href: 'https://met.berkeley.edu',
    dates: 'Aug. 2026 - Present',
    place: 'Berkeley, California, United States',
    logo: '/logos/berkeley.svg',
  },
  {
    role: 'Software Engineering Intern',
    org: 'Air Force Research Laboratory',
    href: 'https://www.afrl.af.mil',
    dates: 'Jun. 2025 - Aug. 2025',
    span: '3 mo',
    place: 'Wright-Patterson AFB, Ohio, United States',
    logo: '/logos/afrl.svg',
  },
  {
    role: 'Machine Learning Intern',
    org: 'AgentAI',
    href: 'https://www.agentai.app',
    dates: 'Jun. 2024 - Aug. 2024',
    span: '3 mo',
    place: 'Woodland Hills, California, United States',
    logo: '/logos/agentai.svg',
  },
];

const wins = [
  {
    event: 'Gemini 4 Argon Hackathon',
    href: 'https://cerebralvalley.ai/e/gemini-4-argon-sf',
    host: 'Cerebral Valley',
    sponsor: { src: '/sponsors/google-deepmind.svg', alt: 'Google DeepMind', h: 22 },
    project: 'LabTwin',
    pitch: 'Digital twin world models for the wet lab. Test your experiment virtually before you run it.',
    badge: '$7.5k prize',
    date: 'Oct. 2026',
    image: '/projects/labtwin.jpg',
    links: [{ label: 'GitHub', href: 'https://github.com/benjaminxie1/argon-hacks' }],
  },
  {
    event: 'a16z SpeedHacks',
    href: 'https://www.tech-week.com/calendar/sf/events/speedhacks-the-official-speedrun-hackathon-30c239a4-638a-4bd6-8d51-e15259668f51',
    host: 'a16z speedrun',
    sponsor: { src: '/sponsors/a16z-mark.png', alt: '', h: 20, text: 'a16z' },
    project: 'Recourse',
    pitch: 'An agent that preps refund and insurance claims, then makes the call.',
    badge: '$1k prize',
    date: 'Oct. 2026',
    links: [{ label: 'GitHub', href: 'https://github.com/Will-code112223/Speedhacks' }],
  },
  {
    event: 'Congressional App Challenge',
    href: 'https://www.congressionalappchallenge.us/24-CA26/',
    host: 'Rep. Julia Brownley, CA-26',
    sponsor: { src: '/sponsors/cac.png', alt: 'Congressional App Challenge', h: 24, dark: true },
    project: 'Sentinel',
    pitch: 'A YOLO wildfire-detection camera network, piloted in the Santa Monica Mountains.',
    badge: 'U.S. Capitol',
    date: '2024',
    image: '/projects/sentinel.jpg',
    links: [
      { label: 'YouTube', href: 'https://www.youtube.com/watch?v=MKWk8RUUmRI' },
      { label: 'GitHub', href: 'https://github.com/benjaminxie1/sentinel-app' },
    ],
  },
];
---

<Base title="Experience">
  <main>
    <h1>Experience</h1>
    <ol class="timeline">
      {experience.map((e) => (
        <li>
          <img class="logo" src={e.logo} alt="" width="60" height="60" />
          <div>
            <a class="role" href={e.href}>{e.role}</a>.
            <div>{e.org}.</div>
            <div>{e.dates}.{e.span && <span class="muted small"> ({e.span})</span>}</div>
            <div class="muted">{e.place}.</div>
          </div>
        </li>
      ))}
    </ol>

    <h2>Projects</h2>
    <ul class="wins">
      {wins.map((w) => (
        <li>
          <div class="win">
            <a class="shot" href={w.links[0].href} aria-label={`${w.project} on ${w.links[0].label}`}>
              {w.image ? (
                <img src={w.image} alt="" width="800" height="500" loading="lazy" />
              ) : (
                <div class="rc" aria-hidden="true">
                  <div class="rc-bar"><span></span><span></span><span></span></div>
                  <div class="rc-msg">Ridgeline charged me twice but I lost the receipt</div>
                  <div class="rc-card">
                    <div class="rc-row"><span class="rc-k">Refund request</span><span class="rc-v">$214.00</span></div>
                    <div class="rc-row"><span class="rc-k">Support line</span><span class="rc-pill">Ready</span></div>
                    <div class="rc-btn">Approve this call</div>
                  </div>
                </div>
              )}
            </a>
            <div class="info">
              <span class={w.sponsor.dark ? 'sponsor dark' : 'sponsor'}>
                <img src={w.sponsor.src} alt={w.sponsor.alt} style={`height:${w.sponsor.h}px`} />
                {w.sponsor.text && <span class="sponsor-text">{w.sponsor.text}</span>}
              </span>
              <div class="line">
                <a class="ev" href={w.href}>{w.event}</a><span class="dots"></span><span class="amt">1st Place</span>
              </div>
              <div class="meta muted small">
                <span class="prize">{w.badge}</span>
                <span><strong>{w.project}</strong> · {w.host} · {w.date}</span>
              </div>
              <p class="small pitch">
                {w.pitch}
                {w.links.map((l) => <> <a class="lk" href={l.href}>{l.label}&nbsp;↗</a></>)}
              </p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </main>
</Base>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    max-width: 780px;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr);
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 16px;
    line-height: 1.85;
  }
  .timeline li:first-child {
    padding-top: 12px;
  }
  .logo {
    width: 60px;
    height: 60px;
    object-fit: contain;
  }
  .role {
    font-size: 18px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .role:hover {
    color: var(--link);
  }
  h2 {
    margin-top: 64px;
  }
  .wins {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    max-width: 780px;
    display: grid;
    gap: 18px;
  }
  .win {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 26px;
    align-items: center;
    padding: 14px;
    border: 1px solid var(--rule);
    border-radius: 16px;
    background: #fdfcf9;
    color: var(--ink);
    transition: border-color 0.18s;
  }
  .win:hover {
    border-color: color-mix(in srgb, var(--muted) 55%, transparent);
  }
  .shot {
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    overflow: hidden;
    background: #2e3038;
  }
  .shot {
    display: block;
    transition: transform 0.18s;
  }
  .shot:hover {
    transform: scale(1.015);
  }
  .sponsor {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 6px;
  }
  .sponsor.dark {
    padding: 4px 8px;
    border-radius: 6px;
    background: #14284a;
  }
  .sponsor img {
    display: block;
    width: auto;
  }
  .sponsor-text {
    font-family: system-ui, -apple-system, 'Helvetica Neue', sans-serif;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.02em;
    color: #111111;
  }
  .lk {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--muted) 60%, transparent);
    text-underline-offset: 3px;
  }
  .lk:hover {
    color: var(--link);
  }
  .shot > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .info {
    padding-right: 10px;
    line-height: 1.75;
  }
  .line {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .ev {
    font-size: 18px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
  }
  .dots {
    flex: 1;
    min-width: 16px;
    border-bottom: 2px dotted color-mix(in srgb, var(--muted) 45%, transparent);
    transform: translateY(-5px);
  }
  .amt {
    font-family: var(--hand);
    font-size: 30px;
    line-height: 1;
    white-space: nowrap;
    color: var(--link);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
    margin-top: 6px;
  }
  .prize {
    display: inline-block;
    padding: 1px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--link) 13%, transparent);
    color: var(--link);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.7;
    vertical-align: 1px;
  }
  .info strong {
    color: var(--ink);
    font-weight: 600;
  }
  .pitch {
    margin: 6px 0 0;
    color: var(--muted);
    line-height: 1.65;
  }
  /* Recourse mini-UI, in the app's own black-on-white style */
  .rc {
    height: 100%;
    background: #ffffff;
    color: #111111;
    font: 10.5px/1.4 system-ui, -apple-system, sans-serif;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }
  .rc-bar {
    display: flex;
    gap: 4px;
  }
  .rc-bar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #dddddd;
  }
  .rc-msg {
    align-self: flex-end;
    max-width: 82%;
    background: #111111;
    color: #f2f2f2;
    padding: 6px 9px;
    border-radius: 10px 10px 2px 10px;
  }
  .rc-card {
    border: 1px solid #dddddd;
    border-radius: 8px;
    padding: 7px 10px;
    display: grid;
    gap: 4px;
  }
  .rc-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .rc-k {
    color: #666666;
  }
  .rc-v {
    font-weight: 600;
  }
  .rc-pill {
    font-size: 9.5px;
    padding: 1px 7px;
    border-radius: 99px;
    background: #e8f3ec;
    color: #2f6b45;
  }
  .rc-btn {
    margin-top: 2px;
    text-align: center;
    background: #111111;
    color: #ffffff;
    border-radius: 6px;
    padding: 5px 0;
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .timeline li {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 16px;
    }
    .logo {
      width: 44px;
      height: 44px;
    }
    .win {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    .info {
      padding: 0 4px 4px;
    }
    .line {
      justify-content: space-between;
    }
    .dots {
      display: none;
    }
  }
</style>
