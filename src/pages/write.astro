---
// /write — Ben's private blog editor. You type directly into the post as it
// will appear on the site (same banner, title, drop cap, styles). Writing
// autosaves on this device, per post; saving a draft or publishing commits the
// post to GitHub, which redeploys the site. Needs a fine-grained GitHub token
// (Contents: read/write on this repo only), stored in this browser.
// Formatting UI lives in the editor module; this page is the app shell.
import Base from '../layouts/Base.astro';
import PostBanner from '../components/PostBanner.astro';
import '../styles/post.css';
import '../scripts/write/ui/app.css';
const today = new Date().toISOString().slice(0, 10);
---

<Base title="Write" noindex>
  <div class="wbar" role="region" aria-label="Post actions">
    <div class="wbar-in">
      <button type="button" class="wb-btn wb-posts" data-act="posts" title="All posts">
        <svg class="ico" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
        <span class="lbl">Posts</span>
      </button>
      <div class="wb-state" data-kind="idle">
        <span class="dot" aria-hidden="true"></span>
        <span class="st-text">New post</span>
      </div>
      <span class="wb-gap"></span>
      <span class="wb-stats" aria-label="Length"></span>
      <button type="button" class="wb-btn wb-preview" data-act="preview">
        Preview
        <svg class="ico" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <button type="button" class="wb-btn wb-primary" data-act="primary">Publish…</button>
      <div class="wb-more-wrap">
        <button type="button" class="wb-btn wb-more" data-act="more" aria-label="More actions" aria-haspopup="menu" aria-expanded="false" title="More">
          <svg class="ico" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="6" cy="12" r="1.6" fill="currentColor"></circle><circle cx="12" cy="12" r="1.6" fill="currentColor"></circle><circle cx="18" cy="12" r="1.6" fill="currentColor"></circle></svg>
        </button>
      </div>
    </div>
  </div>

  <main class="post-main write">
    <PostBanner seed="new-post" manual />
    <article class="post">
      <div class="notices">
        <aside class="note onboard" aria-label="Getting started" hidden>
          <p><b>Your writing saves on this device.</b> To publish, connect GitHub once.</p>
          <div class="note-btns">
            <button type="button" class="btn btn-primary" data-act="connect">Connect GitHub</button>
            <button type="button" class="btn btn-quiet" data-act="dismiss-onboard">Not now</button>
          </div>
        </aside>
        <aside class="note remote" aria-label="Newer version available" hidden></aside>
      </div>
      <header class="head">
        <h1><textarea class="title-in" rows="1" placeholder="Title" aria-label="Title"></textarea></h1>
        <p class="dek"><textarea class="dek-in" rows="1" placeholder="A one-line summary (optional)" aria-label="Summary"></textarea></p>
      </header>
      <div class="meta">
        <p class="published">
          <span class="m-state">Draft ·</span>
          <button type="button" class="m-date" aria-label="Change date"></button>
          <input class="date-in" type="date" value={today} tabindex="-1" aria-label="Date" />
        </p>
        <p class="url-line"></p>
      </div>
      <div class="editor"></div>
    </article>
  </main>
</Base>

<script>
  import '../scripts/write/main';
</script>
