---
import Base from '../layouts/Base.astro';
import HomeArt from '../components/HomeArt.astro';
import { linkTarget } from '../data/site';
import { renderInline } from '../lib/inline';
import { loadSiteFile } from '../lib/site-content';
import { newItemFor, type SiteLink } from '../content/site/schema';
import raw from '../content/site/home.json';

const home = loadSiteFile('home', raw);
const newPara = newItemFor('home', '/paragraphs') as string;
const newLink = newItemFor('home', '/links') as SiteLink;
---

<Base fit>
  <main class="home">
    <section class="intro">
      <h1 data-edit="home:/heading" data-edit-kind="plain">{home.heading}</h1>
      {(() => {
        // list items; each is also rendered from the schema's newItem into the editor's <template>
        const Para = (p: string, i: number | string) => (
          <p data-edit-item={`home:/paragraphs/${i}`} data-edit={`home:/paragraphs/${i}`} data-edit-kind="inline" set:html={renderInline(p)} />
        );
        const Link = (l: SiteLink, i: number | string) => {
          const t = linkTarget(l, `home:/links/${i}`);
          return (
            <a
              href={t.href}
              data-edit-item={`home:/links/${i}`}
              data-edit-sitelink={`home:/links/${i}`}
              data-edit={`home:/links/${i}/label`}
              data-edit-kind="plain"
              data-edit-href={t.editHref}
            >{l.label}</a>
          );
        };
        return (
          <>
            <div class="paras" data-edit-list="home:/paragraphs">{home.paragraphs.map((p, i) => Para(p, i))}</div>
            <template data-edit-template="home:/paragraphs">{Para(newPara, '__i__')}</template>
            <p class="links" data-edit-list="home:/links">{home.links.map((l, i) => Link(l, i))}</p>
            <template data-edit-template="home:/links">{Link(newLink, '__i__')}</template>
          </>
        );
      })()}
    </section>
    <div class="art"><HomeArt /></div>
  </main>
</Base>

<style>
  .home {
    position: relative;
  }
  @media (min-width: 961px) and (min-height: 560px) {
    .home .intro { flex: 1; min-height: 0; }
    .intro h1 { font-size: clamp(52px, 8.5vh, 72px); margin-bottom: clamp(14px, 2.6vh, 28px); }
    .intro p { margin-bottom: clamp(8px, 1.6vh, 16px); }
  }
  /* Art fills the open space right of the text, out to the page edge, behind nothing. */
  .art {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 600px;
    right: calc(min(0px, (1040px - 100vw) / 2) + 48px);
    max-width: 820px;
    margin-left: auto;
    pointer-events: none;
  }
  @media (max-width: 1100px) {
    .art { left: 520px; }
  }
  @media (max-width: 960px) {
    .art {
      position: relative;
      left: auto;
      right: auto;
      height: 70vw;
      max-height: 520px;
      margin: 8px -28px 0;
    }
    .intro { min-height: auto; padding-top: 24px; }
  }
  @media (max-width: 640px) {
    /* phones: the bust sits right under the links, inside the page (no sideways scroll) */
    .art { height: 100vw; max-height: 480px; margin: -88px -20px -24px; }
  }
  .intro {
    position: relative;
    z-index: 1;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    font-size: 17px;
    line-height: 1.75;
  }
  .intro h1 {
    font-size: 72px;
    margin-bottom: 28px;
  }
  .intro p {
    margin: 0 0 16px;
    overflow-wrap: break-word;
  }
  /* the paragraph list wrapper doesn't take part in layout */
  .paras {
    display: contents;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 24px !important;
  }
  .links a {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 4px;
  }
  .links a:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }
  @media (max-width: 640px) {
    .intro {
      min-height: auto;
      padding-top: 24px;
      font-size: 16px;
    }
    .intro h1 {
      font-size: 56px;
    }
  }
</style>
