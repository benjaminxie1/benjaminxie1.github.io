---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WillowPond from '../components/WillowPond.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });

---

<Base>
  <main>
    <section class="hero">
      <figure class="art" title="Click the water to feed the koi">
        <WillowPond />
        <figcaption aria-label="柳暗花明又一村">{[...'柳暗花明又一村'].map((ch) => <span aria-hidden="true">{ch}</span>)}</figcaption>
      </figure>
      <div class="intro">
        <h1>Hi, I'm Ben.</h1>
        <p>EECS + Business @ <a href="https://met.berkeley.edu">UC Berkeley</a> (M.E.T. '29).</p>
        <p>Currently, backend &amp; security @ <a href="https://www.shell.com">Shell</a>.</p>
        <p>Previously, <a href="/about">Air Force Research Lab</a> &amp; <a href="/about">AgentAI</a>.</p>
        <p>Recently, won <a href="https://github.com/benjaminxie1/argon-hacks">Gemini 4 Argon Hacks</a> &amp; <a href="https://github.com/Will-code112223/Speedhacks">a16z SpeedHacks</a>.</p>
        <p>Built <a href="/projects">Sentinel</a>, a wildfire camera network, and took it to the U.S. Capitol.</p>
        <p class="pills">
          <a class="pill" href={site.github}>GitHub</a>
          <a class="pill" href={site.linkedin}>LinkedIn</a>
          <a class="pill" href={`mailto:${site.email}`}>Email</a>
        </p>
      </div>
    </section>

    <section>
      <h2>Selected projects</h2>
      <ul class="plain projects">
        {projects.map((p) => (
          <li>
            <a class="name" href={p.links[0]?.href}>{p.name}</a>
            {p.award && <span class="tag">{p.award}</span>}
            <div class="muted blurb">{p.blurb}</div>
          </li>
        ))}
      </ul>
    </section>

    <section class="writing">
      <h2>Writing</h2>
      <ul class="plain">
        {posts.map((p) => (
          <li><a href={`/blog/${p.id}/`}>{p.data.title}</a> <span class="muted small">· {fmt(p.data.date)}</span></li>
        ))}
      </ul>
    </section>
  </main>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 440px) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    margin-bottom: 72px;
  }
  .art {
    position: relative;
    margin: 0;
    aspect-ratio: 440 / 520;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--tile);
    cursor: crosshair;
  }
  .art figcaption {
    position: absolute;
    top: 16px;
    right: 14px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-family: 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', serif;
    font-size: 13px;
    line-height: 1;
    color: var(--muted);
    pointer-events: none;
  }
  .intro p {
    margin: 0 0 6px;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px !important;
  }
  .projects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 48px;
  }
  .projects li {
    padding: 10px 0;
  }
  .name {
    font-weight: 600;
  }
  .blurb {
    font-size: 15px;
    margin-top: 2px;
  }
  .writing {
    max-width: 560px;
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .art {
      max-width: 440px;
      width: 100%;
    }
    .art {
      aspect-ratio: 5 / 4;
    }
    .art figcaption {
      display: none;
    }
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
