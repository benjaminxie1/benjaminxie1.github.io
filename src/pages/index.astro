---
import Base from '../layouts/Base.astro';
import WillowPond from '../components/WillowPond.astro';
import { site } from '../data/site';

---

<Base>
  <main>
    <section class="hero">
      <figure class="art" title="Click the water to feed the koi">
        <WillowPond />
        <figcaption aria-label="柳暗花明又一村">{[...'柳暗花明又一村'].map((ch) => <span aria-hidden="true">{ch}</span>)}</figcaption>
      </figure>
      <div class="intro">
        <h1>Hi, I'm Ben.</h1>
        <p>I'm a student studying Electrical Engineering &amp; Computer Sciences (EECS) and Business @ <a href="https://www.berkeley.edu">UC Berkeley</a> in the <a href="https://met.berkeley.edu">M.E.T. program</a>.</p>
        <p>Before that, I interned at the <a href="https://www.afrl.af.mil">Air Force Research Lab</a> as a software engineering intern, and at AgentAI as a machine learning intern.</p>
        <p>Recently, I won <a href="https://github.com/benjaminxie1/argon-hacks">Gemini 4 Argon Hacks</a> @ Cerebral Valley and <a href="https://github.com/Will-code112223/Speedhacks">a16z SpeedHacks</a>.</p>
        <p class="links">
          <a href={site.github}>GitHub</a>
          <a href={site.linkedin}>LinkedIn</a>
          <a href={site.x}>X</a>
          <a href={`mailto:${site.email}`}>Email</a>
        </p>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 440px) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    min-height: calc(100dvh - 240px);
    margin-bottom: 0;
  }
  .art {
    position: relative;
    margin: 0;
    aspect-ratio: 440 / 520;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: var(--tile);
    cursor: crosshair;
  }
  .art figcaption {
    position: absolute;
    top: 16px;
    right: 14px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-family: 'Songti SC', 'Noto Serif CJK SC', 'Source Han Serif SC', serif;
    font-size: 13px;
    line-height: 1;
    color: var(--muted);
    pointer-events: none;
  }
  .intro p {
    margin: 0 0 14px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 22px !important;
  }
  .links a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 4px;
  }
  .links a:hover {
    color: var(--link);
    text-decoration-color: currentColor;
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .art {
      max-width: 440px;
      width: 100%;
    }
    .art {
      aspect-ratio: 5 / 4;
    }
    .art figcaption {
      display: none;
    }
  }
</style>
