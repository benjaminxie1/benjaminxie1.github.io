---
// Header art for a blog post: a field of small ink triangles on paper that
// dissolves into the page along a ragged edge. Seeded by the post slug, so each
// post gets its own (stable) pattern. If a cover image is set, its tones drive
// the density instead. A few cells slowly flicker so it feels alive.
interface Props {
  seed: string;
  cover?: string;
  /** Leave mounting to the page (the /write editor drives it live). */
  manual?: boolean;
}
const { seed, cover, manual = false } = Astro.props;
---

<div class="post-banner" data-seed={seed} data-cover={cover ?? ''} data-manual={manual ? '' : undefined} aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  import { mountBanner } from '../scripts/banner';
  document.querySelectorAll<HTMLElement>('.post-banner:not([data-manual])').forEach((root) => {
    mountBanner(root, { seed: root.dataset.seed || 'post', cover: root.dataset.cover || undefined });
  });
</script>

<style>
  .post-banner {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 300px;
    margin-top: -40px; /* tuck under the nav spacing */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 22%),
      linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent 0, #000 22%),
      linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
    mask-composite: intersect;
  }
  .post-banner canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .post-banner:global(.live) canvas {
    opacity: 1;
  }
  @media (max-width: 640px) {
    .post-banner { height: 120px; margin-top: -16px; margin-bottom: -20px; }
  }
</style>
