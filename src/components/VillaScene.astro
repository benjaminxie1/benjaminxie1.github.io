---
// Ben's dithered villa landscape, brought to life with a small WebGL shader:
// a slow, gentle breathing warp: sky drift, swaying foliage, rippling field rows.
// Purely ambient (no pointer or click interaction).
---

<figure class="villa">
  <img src="/art/villa-light.png" alt="Dithered landscape: a villa among cypresses under a deep blue sky with billowing clouds" width="1024" height="1024" />
  <canvas aria-hidden="true"></canvas>
</figure>

<script>
  const root = document.querySelector<HTMLElement>('figure.villa');
  // The visible <img> is a pre-baked light still; the shader samples the original.
  const img = new Image();
  img.decoding = 'async';
  img.src = '/art/villa.webp';
  const canvas = root?.querySelector('canvas');
  const gl = canvas?.getContext('webgl', { premultipliedAlpha: false, antialias: false });

  const VERT = `attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;
  const FRAG = `
    precision highp float;
    uniform sampler2D tex;
    uniform vec2 res;       // canvas size in device px
    uniform vec2 cover;     // uv scale for object-fit: cover
    uniform vec2 shift;     // uv offset for object-position
    uniform float t;
    uniform float motion;   // 0 = still, 1 = alive
    uniform float px;       // device px per dither cell

    float bayer4(vec2 c) {
      vec2 a = mod(floor(c), 4.0);
      float i = a.x + a.y * 4.0;
      // 4x4 Bayer matrix, row-major
      float m[16];
      m[0]=0.;m[1]=8.;m[2]=2.;m[3]=10.;m[4]=12.;m[5]=4.;m[6]=14.;m[7]=6.;
      m[8]=3.;m[9]=11.;m[10]=1.;m[11]=9.;m[12]=15.;m[13]=7.;m[14]=13.;m[15]=5.;
      float v = 0.0;
      for (int k = 0; k < 16; k++) { if (float(k) == i) v = m[k]; }
      return (v + 0.5) / 16.0;
    }
    float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float noise(vec2 p){
      vec2 i = floor(p), f = fract(p); f = f*f*(3.0-2.0*f);
      return mix(mix(hash(i), hash(i+vec2(1,0)), f.x), mix(hash(i+vec2(0,1)), hash(i+vec2(1,1)), f.x), f.y);
    }

    void main() {
      vec2 frag = vec2(gl_FragCoord.x, res.y - gl_FragCoord.y);
      vec2 uv = frag / res * cover + shift;          // image uv (0..1), y down
      vec2 d = vec2(0.0);

      // sky: slow breathing drift (stronger high up)
      float sky = 1.0 - smoothstep(0.42, 0.6, uv.y);
      d.x += sky * motion * (0.0018 * sin(t * 0.15 + uv.y * 7.0) + 0.0015 * (noise(uv * 3.0 + vec2(t * 0.04, 0.0)) - 0.5));
      d.y += sky * motion * 0.0008 * sin(t * 0.18 + uv.x * 5.0);

      // foliage band: gentle sway, more at the tops
      float trees = smoothstep(0.4, 0.5, uv.y) * (1.0 - smoothstep(0.7, 0.78, uv.y));
      d.x += trees * motion * 0.0011 * sin(t * 0.7 + uv.x * 9.0 + uv.y * 26.0) * (0.6 + 0.4 * noise(uv * 6.0 + t * 0.2));

      // field: rows ripple like wind through crops
      float field = smoothstep(0.74, 0.8, uv.y);
      d.y += field * motion * 0.0009 * sin(t * 1.0 - uv.y * 70.0 + uv.x * 10.0);
      d.x += field * motion * 0.0006 * sin(t * 0.7 + uv.x * 30.0);

      vec3 col = texture2D(tex, clamp(uv + d, 0.0, 1.0)).rgb;

      // recolor to the site: re-dither into fine dots on paper white
      vec3 paper = vec3(0.973, 0.965, 0.945);
      float lum = dot(col, vec3(0.299, 0.587, 0.114));
      float tone = 1.0 - smoothstep(0.12, 0.85, lum);          // 0 = paper, 1 = darkest
      float blueish = smoothstep(0.02, 0.14, col.b - col.r);
      vec3 inkTone = mix(vec3(0.36, 0.33, 0.30), vec3(0.27, 0.38, 0.66), blueish);
      float breathe = 1.0 + motion * 0.03 * sin(t * 0.45);
      float th = bayer4(frag / px);
      float dotOn = step(th, tone * 0.62 * breathe);          // max ~62% coverage: stays mostly white
      col = mix(paper, inkTone, dotOn * 0.85);

      gl_FragColor = vec4(col, 1.0);
    }`;

  if (root && img && canvas && gl) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      canvas.remove(); // fall back to the plain image
    } else {
      gl.useProgram(prog);
      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const U = (n: string) => gl.getUniformLocation(prog, n);
      const u = { res: U('res'), cover: U('cover'), shift: U('shift'), t: U('t'), motion: U('motion'), px: U('px') };

      const tex = gl.createTexture();
      let ready = false;
      const upload = () => {
        gl.bindTexture(gl.TEXTURE_2D, tex);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, img);
        ready = true;
        root.classList.add('live');
        frame(performance.now());
      };
      // object-fit: cover; object-position: 50% 58% (matches the CSS on the <img>)
      let cw = 0, ch = 0, dpr = 1;
      const cover = [1, 1], shift = [0, 0];
      const resize = () => {
        const r = root.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        cw = Math.max(1, Math.round(r.width * dpr));
        ch = Math.max(1, Math.round(r.height * dpr));
        canvas.width = cw;
        canvas.height = ch;
        gl.viewport(0, 0, cw, ch);
        const boxA = r.width / r.height;
        if (boxA > 1) { cover[0] = 1; cover[1] = 1 / boxA; }
        else { cover[0] = boxA; cover[1] = 1; }
        shift[0] = (1 - cover[0]) * 0.5;
        shift[1] = (1 - cover[1]) * 0.58;
        if (ready) frame(performance.now());
      };
      new ResizeObserver(resize).observe(root);
      resize();

      let raf = 0, visible = true;
      function frame(now: number) {
        if (!ready) return;
        const t = now / 1000;
        gl.uniform2f(u.res, cw, ch);
        gl.uniform2f(u.cover, cover[0], cover[1]);
        gl.uniform2f(u.shift, shift[0], shift[1]);
        gl.uniform1f(u.t, t);
        gl.uniform1f(u.motion, reduced.matches ? 0 : 1);
        gl.uniform1f(u.px, 1.5 * dpr);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      }
      function loop(now: number) {
        frame(now);
        raf = requestAnimationFrame(loop);
      }
      const schedule = () => {
        cancelAnimationFrame(raf);
        if (visible && !document.hidden && !reduced.matches) raf = requestAnimationFrame(loop);
      };
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; schedule(); }).observe(root);
      document.addEventListener('visibilitychange', schedule);
      reduced.addEventListener('change', () => { schedule(); frame(performance.now()); });
      if (img.complete && img.naturalWidth) upload();
      else img.addEventListener('load', upload, { once: true });
      schedule();
    }
  }
</script>

<style>
  /* Full-bleed, no card: the image melts into the page at the top and sides. */
  .villa {
    position: relative;
    margin: 0;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    aspect-ratio: 21 / 9;
    max-height: 640px;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 38%, #000 80%, transparent 100%),
      linear-gradient(to right, transparent 0%, #000 14%, #000 86%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent 0%, #000 38%, #000 80%, transparent 100%),
      linear-gradient(to right, transparent 0%, #000 14%, #000 86%, transparent 100%);
    mask-composite: intersect;
  }
  .villa img,
  .villa canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .villa img {
    object-fit: cover;
    object-position: 50% 58%;
    image-rendering: pixelated;
  }
  .villa canvas {
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .villa.live canvas {
    opacity: 1;
  }
  @media (max-width: 640px) {
    .villa {
      aspect-ratio: 4 / 3;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 35%, #000 82%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 35%, #000 82%, transparent 100%);
    }
  }
</style>
